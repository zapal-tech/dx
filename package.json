{
  "name": "@zapal/dx",
  "version": "1.3.1",
  "description": "Zapal DX. Set of code quality tools configurations, rule sets and utilities. Prettier, ESLint, TypeScript, Commitlint, etc.",
  "keywords": [
    "zapal",
    "dx",
    "development",
    "experience",
    "eslint",
    "prettier",
    "typescript",
    "code",
    "quality",
    "tools",
    "configurations"
  ],
  "homepage": "https://github.com/zapal-tech/dx#readme",
  "bugs": {
    "url": "https://github.com/zapal-tech/dx/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zapal-tech/dx.git"
  },
  "license": "MIT",
  "author": {
    "name": "Zapal",
    "email": "hello@zapal.tech",
    "url": "https://www.zapal.tech"
  },
  "type": "module",
  "exports": {
    "./commitlint": "./commitlint/index.js",
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js",
    "./typescript": "./typescript/default.tsconfig.json",
    "./typescript/next": "./typescript/next.tsconfig.json",
    "./typescript/payload": "./typescript/payload.tsconfig.json",
    "./typescript/svelte": "./typescript/svelte.tsconfig.json"
  },
  "files": [
    "commitlint",
    "eslint",
    "prettier",
    "typescript"
  ],
  "scripts": {
    "build": "pnpm copy:typescript && tsup",
    "check-updates": "pnpx taze major -r",
    "copy:typescript": "copyfiles -f src/typescript/* typescript",
    "dev": "pnpm copy:typescript && tsup --watch src",
    "lint": "eslint src",
    "prepare": "node ./scripts/prepare"
  },
  "prettier": "./prettier/index.js",
  "dependencies": {
    "@eslint/js": "catalog:",
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/types": "catalog:",
    "@types/eslint-config-prettier": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "copyfiles": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@commitlint/cli": ">=19 <21",
    "@commitlint/config-conventional": ">=19 <21",
    "@commitlint/config-pnpm-scopes": ">=19 <21",
    "eslint": ">=9 <10",
    "prettier": ">=3 <4",
    "typescript": ">=5 <6"
  },
  "peerDependenciesMeta": {
    "@commitlint/cli": {
      "optional": true
    },
    "@commitlint/config-conventional": {
      "optional": true
    },
    "@commitlint/config-pnpm-scopes": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
